menuconfig APP_MENU
    bool "Enable App Menu"
    default n
    help
      Enable the application menu module.

config APP_BG_LOG_LEVEL
    int "BG APP Log Level"
    default 3
    range 0 4
    help
      0: OFF, 1: ERROR, 2: WARNING, 3: INFO, 4: DEBUG

config APP_FG_LOG_LEVEL
    int "FG APP Log Level"
    default 3
    range 0 4
    help
      0: OFF, 1: ERROR, 2: WARNING, 3: INFO, 4: DEBUG

config APP_FG_PRIORITY_DEFAULT
    int "Default App Foreground Priority"
    default 5
    help
      Default priority for foreground applications.
