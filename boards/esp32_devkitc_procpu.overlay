// #include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>

/ {
    chosen {
        zephyr,console = &uart0;
        zephyr,shell-uart = &uart0;
        zephyr,display = &st7789;
    };

    aliases {
        
    };

    mipi_dbi: mipi_dbi {
        compatible = "zephyr,mipi-dbi-spi";
        #address-cells = <1>;
        #size-cells = <0>;
        spi-dev = <&spi3>;
        dc-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
        write-only;

        st7789: st7789@0 {
            compatible = "sitronix,st7789v";
            mipi-max-frequency = <30000000>;
            reg = <0>;
            width = <240>;
            height = <240>;
            x-offset = <0>;
            y-offset = <0>;
            vcom = <0x19>;
            gctrl = <0x35>;
            vrhs = <0x12>;
            vdvs = <0x20>;
            mdac = <0x00>;
            gamma = <0x01>;
            colmod = <0x05>;
            lcm = <0x2c>;
            porch-param = [0c 0c 00 33 33];
            cmd2en-param = [5a 69 02 01];
            pwctrl1-param = [a4 a1];
            pvgam-param = [D0 04 0D 11 13 2B 3F 54 4C 18 0D 0B 1F 23];
            nvgam-param = [D0 04 0C 11 13 2C 3F 44 51 2F 1F 1F 20 23];
            ram-param = [00 F0];
            rgb-param = [CD 08 14];
            mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
            status = "okay";
            mipi-cpol;
            mipi-cpha;
        };
    };

    leds {
        compatible = "gpio-leds";
        status = "okay";

        backlight: led_0 {
            gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
        };
    };
};

&pinctrl {
    /omit-if-no-ref/ spim2_default: spim2_default {
        group1 {
            pinmux = <SPIM2_MISO_GPIO26>,
                <SPIM2_SCLK_GPIO14>,
                <SPIM2_CSEL_GPIO15>;
        };

        group2 {
            pinmux = <SPIM2_MOSI_GPIO13>;
            output-low;
        };
    };

    /omit-if-no-ref/ spim3_default: spim3_default {
        group1 {
            pinmux = <SPIM3_MISO_GPIO9>,
                <SPIM3_SCLK_GPIO18>,
                <0>;
        };

        group2 {
            pinmux = <SPIM3_MOSI_GPIO23>;
            output-low;
        };
    };
};

&spi2 {
    sdhc_spi: sdhc_spi@0 {
        compatible = "zephyr,sdhc-spi-slot";
        reg = <0>;
        spi-max-frequency = <20000000>;
        status = "okay";
        mmc {
            compatible = "zephyr,sdmmc-disk";
            disk-name = "SD";
            status = "okay";
        };
    };
};
